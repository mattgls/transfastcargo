---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';

const sections = await getCollection('sections');
const histoire = sections.find((s) => s.data.key === 'histoire');
const prestations = sections.find((s) => s.data.key === 'prestations');
const tarifs = sections.find((s) => s.data.key === 'tarifs');
const contact = sections.find((s) => s.data.key === 'contact');

const HistoireContent = histoire ? (await render(histoire)).Content : null;
const PrestationsContent = prestations ? (await render(prestations)).Content : null;
const TarifsContent = tarifs ? (await render(tarifs)).Content : null;
const ContactContent = contact ? (await render(contact)).Content : null;

const galleryImages = Array.from({ length: 21 }, (_, i) => `img-${i + 1}.jpg`).filter((f) => f !== 'img-2.jpg');
const galleryJson = JSON.stringify(galleryImages.map((f) => `/gallery/${f}`));
const histoireImage = '/gallery/img-2.jpg';

const mapSvg = fs.readFileSync('public/paris-map.svg', 'utf-8').replace(/<\?xml[^>]*\?>/, '').trim();
---
<BaseLayout title="Transport & livraison" description="TransFastCargo — transport et livraison rapides.">
  <section id="hero" class="hero">
    <div class="hero-inner">
      <img src="/logo.svg" alt="TransFastCargo" class="hero-logo" />
      <h1 class="sr-only">TransFastCargo</h1>
      <img src="/texttransfastcargo.svg" alt="TransFastCargo" class="hero-wordmark" />
      <p class="hero-sub">Transport &amp; livraison — rapide, fiable, sans détour.</p>
      <a href="#contact" class="hero-cta">Nous contacter</a>
    </div>
  </section>

  <section id="mon-histoire" class="section">
    <div class="container">
      <div class="histoire-grid">
        <div>
          <h2 class="section-title">{histoire?.data.title ?? 'Mon histoire'}</h2>
          <div class="prose">
            {HistoireContent && <HistoireContent />}
          </div>
        </div>
        <img src={histoireImage} alt="Mon histoire" class="histoire-img" />
      </div>
    </div>
  </section>

  <section id="prestations" class="section section--alt">
    <div class="container">
      <h2 class="section-title">{prestations?.data.title ?? 'Prestations'}</h2>
      <div class="prose">
        {PrestationsContent && <PrestationsContent />}
      </div>
      <div class="gallery" id="gallery" data-images={galleryJson}>
        {galleryImages.map((file, idx) => (
          <button type="button" class="gallery-item" data-index={idx} aria-label={`Voir la photo ${idx + 1}`}>
            <img src={`/gallery/${file}`} alt={`Prestation ${idx + 1}`} loading="lazy" />
          </button>
        ))}
      </div>
    </div>
  </section>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button type="button" class="lb-close" aria-label="Fermer">×</button>
    <button type="button" class="lb-prev" aria-label="Précédente">‹</button>
    <img src="" alt="Photo" class="lb-img" />
    <button type="button" class="lb-next" aria-label="Suivante">›</button>
  </div>

  <section id="tarifs" class="section">
    <div class="container">
      <h2 class="section-title">{tarifs?.data.title ?? 'Tarifs'}</h2>
      <div class="tarifs-map-grid">
        <div class="prose">
          {TarifsContent && <TarifsContent />}
        </div>
        <div id="zone">
          <div class="map-wrap" id="map-wrap">
            <div class="map-tooltip" id="map-tooltip"></div>
            <div class="map-svg" set:html={mapSvg}></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="simulateur" class="section">
    <div class="container">
      <h2 class="section-title">Simulateur de tarif</h2>
      <div class="prose">
        <form class="contact-form sim-form" id="sim-form">
          <label>Adresse de départ
            <div class="autocomplete">
              <input type="text" name="depart" required placeholder="Ex : 10 rue de Rivoli, Paris" autocomplete="off" />
              <ul class="suggest" data-for="depart"></ul>
            </div>
          </label>
          <label>Adresse d'arrivée
            <div class="autocomplete">
              <input type="text" name="arrivee" required placeholder="Ex : Gare de Lyon, Paris" autocomplete="off" />
              <ul class="suggest" data-for="arrivee"></ul>
            </div>
          </label>
          <label>Volume (m³)
            <input type="number" name="volume" min="0" step="0.1" value="1" />
          </label>
          <label>Poids (kg)
            <input type="number" name="poids" min="0" step="1" value="10" />
          </label>
          <button type="submit" class="btn">Simuler le tarif</button>
        </form>
        <div id="sim-result" class="sim-result"></div>
      </div>
    </div>
  </section>

  <section id="contact" class="section section--alt">
    <div class="container">
      <h2 class="section-title">{contact?.data.title ?? 'Contact'}</h2>
      <div class="prose contact-grid">
        <div class="contact-text">
          {ContactContent && <ContactContent />}
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const bike = document.querySelector('.hero-logo');
      if (bike) {
        bike.style.willChange = 'transform';
        const travel = function () { return Math.min(window.innerWidth * 0.9, 750); };
        let ticking = false;
        const update = function () {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          bike.style.transform = 'translateX(' + (p * travel()) + 'px)';
        };
        window.addEventListener('scroll', function () {
          if (!ticking) {
            requestAnimationFrame(function () { update(); ticking = false; });
            ticking = true;
          }
        }, { passive: true });
        update();
      }

      const galleryEl = document.getElementById('gallery');
      const lightbox = document.getElementById('lightbox');
      if (galleryEl && lightbox) {
        const images = JSON.parse(galleryEl.getAttribute('data-images') || '[]');
        const lbImg = lightbox.querySelector('.lb-img');
        let current = 0;
        const show = function (i) {
          current = (i + images.length) % images.length;
          lbImg.setAttribute('src', images[current]);
          lightbox.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        };
        const close = function () {
          lightbox.style.display = 'none';
          document.body.style.overflow = '';
        };
        galleryEl.querySelectorAll('.gallery-item').forEach(function (btn) {
          btn.addEventListener('click', function () {
            show(parseInt(btn.getAttribute('data-index') || '0', 10));
          });
        });
        lightbox.querySelector('.lb-close').addEventListener('click', close);
        lightbox.querySelector('.lb-prev').addEventListener('click', function () { show(current - 1); });
        lightbox.querySelector('.lb-next').addEventListener('click', function () { show(current + 1); });
        lightbox.addEventListener('click', function (e) {
          if (e.target === lightbox) close();
        });
        window.addEventListener('keydown', function (e) {
          if (lightbox.style.display !== 'flex') return;
          if (e.key === 'Escape') close();
          if (e.key === 'ArrowLeft') show(current - 1);
          if (e.key === 'ArrowRight') show(current + 1);
        });
      }

      const mapWrap = document.getElementById('map-wrap');
      const tooltip = document.getElementById('map-tooltip');
      if (mapWrap && tooltip) {
        const arrNames = {
          'arr01':'1er arrondissement','arr02':'2e arrondissement','arr03':'3e arrondissement',
          'arr04':'4e arrondissement','arr05':'5e arrondissement','arr06':'6e arrondissement',
          'arr07':'7e arrondissement','arr08':'8e arrondissement','arr09':'9e arrondissement',
          'arr10':'10e arrondissement','arr11':'11e arrondissement','arr12':'12e arrondissement',
          'arr13':'13e arrondissement','arr14':'14e arrondissement','arr15':'15e arrondissement',
          'arr16':'16e arrondissement','arr17':'17e arrondissement','arr18':'18e arrondissement',
          'arr19':'19e arrondissement','arr20':'20e arrondissement'
        };
        const paths = mapWrap.querySelectorAll('.arrondissement, .commune');
        paths.forEach(function (p) {
          const name = p.getAttribute('data-name') || 'Zone';
          p.addEventListener('mouseenter', function () {
            tooltip.textContent = name;
            tooltip.style.display = 'block';
          });
          p.addEventListener('mousemove', function (e) {
            tooltip.style.left = (e.clientX + 14) + 'px';
            tooltip.style.top = (e.clientY + 14) + 'px';
          });
          p.addEventListener('mouseleave', function () {
            tooltip.style.display = 'none';
          });
        });

        // Communes and arrondissements already present in SVG; no client labels.
      }

      // Tariff simulator
      const simForm = document.getElementById('sim-form');
      const simResult = document.getElementById('sim-result');
      if (simForm && simResult) {
        async function geocode(addr) {
          const url = 'https://api-adresse.data.gouv.fr/search/?q=' + encodeURIComponent(addr) + '&limit=1';
          const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
          const data = await res.json();
          if (!data || !data.features || !data.features.length) throw new Error('Adresse introuvable : ' + addr);
          const coord = data.features[0].geometry.coordinates;
          return { lat: parseFloat(coord[1]), lon: parseFloat(coord[0]) };
        }
        function haversine(a, b) {
          const R = 6371;
          const dLat = (b.lat - a.lat) * Math.PI / 180;
          const dLon = (b.lon - a.lon) * Math.PI / 180;
          const lat1 = a.lat * Math.PI / 180;
          const lat2 = b.lat * Math.PI / 180;
          const x = Math.sin(dLat / 2) ** 2 + Math.sin(dLon / 2) ** 2 * Math.cos(lat1) * Math.cos(lat2);
          return 2 * R * Math.asin(Math.sqrt(x));
        }
        simForm.addEventListener('submit', async function (e) {
          e.preventDefault();
          simResult.textContent = 'Calcul en cours...';
          const depart = simForm.depart.value.trim();
          const arrivee = simForm.arrivee.value.trim();
          const volume = parseFloat(simForm.volume.value) || 0;
          const poids = parseFloat(simForm.poids.value) || 0;
          try {
            const a = await geocode(depart);
            const b = await geocode(arrivee);
            const km = haversine(a, b);
            const price = Math.max(25, 25 + km * 1.2 + volume * 10 + poids * 0.5);
            simResult.innerHTML = 'Distance approx. <strong>' + km.toFixed(1) + ' km</strong> — Tarif estimé : <strong>' + price.toFixed(2) + ' €</strong>';
          } catch (err) {
            simResult.textContent = (err && err.message) ? err.message : 'Erreur lors du calcul.';
          }
        });
      }


      // Address autocomplete (OpenStreetMap / Nominatim)
      function setupAutocomplete(input) {
        const list = input.parentElement.querySelector('.suggest');
        if (!list) return;
        let timer = null;
        let suppressInput = false;
        const hide = function () { list.style.display = 'none'; list.innerHTML = ''; };
        const search = function (q) {
          if (timer) clearTimeout(timer);
          if (!q || q.length < 2) { hide(); return; }
          timer = setTimeout(async function () {
            try {
              const url = 'https://api-adresse.data.gouv.fr/search/?q=' + encodeURIComponent(q) + '&limit=5';
              const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
              const data = await res.json();
              const features = (data && data.features) ? data.features : [];
              list.innerHTML = '';
              if (!features.length) { hide(); return; }
              features.forEach(function (item) {
                const props = item.properties || {};
                const label = props.label || 'Lieu';
                const li = document.createElement('li');
                li.textContent = label;
                li.addEventListener('click', function () {
                  suppressInput = true;
                  input.value = label;
                  hide();
                  setTimeout(function () { suppressInput = false; }, 0);
                });
                list.appendChild(li);
              });
              list.style.display = 'block';
            } catch (e) { hide(); console.error(e); simResult.textContent = 'Autocomplete erreur: ' + e; }
          }, 300);
        };
        input.addEventListener('input', function () { if (suppressInput) return; search(input.value.trim()); });
        input.addEventListener('blur', function () { setTimeout(hide, 200); });
        input.addEventListener('focus', function () { if (input.value.trim().length >= 2) search(input.value.trim()); });
      }
      setupAutocomplete(document.querySelector('input[name="depart"]'));
      setupAutocomplete(document.querySelector('input[name="arrivee"]'));

    })();
  </script>
</BaseLayout>
